# ---------------------------------------------------------------
# LexAI configuration.  Copy this file to ".env" (setup does it for you)
# and edit the values.  NEVER share or commit your real .env file.
# ---------------------------------------------------------------

# REQUIRED for AI features (chat, semantic search, summaries, analysis).
# Create a free key at https://aistudio.google.com/apikey and paste it after the "=".
GEMINI_API_KEY=

# Model names are configurable - change them if Google retires/renames a model.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Server
HOST=127.0.0.1
PORT=5000
# Set to true only when serving over HTTPS
COOKIE_SECURE=false
# Allowed browser origins for the dev server (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave blank: a random secret is generated and stored in data/secret_key
SECRET_KEY=
ALLOW_REGISTRATION=true

# Documents
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=8

# OCR for scanned PDFs (optional). Leave TESSERACT_CMD blank if tesseract is on your PATH.
OCR_ENABLED=true
TESSERACT_CMD=

# Where uploads, the SQLite database and ChromaDB are stored (default: ./data)
# LEXAI_DATA_DIR=
